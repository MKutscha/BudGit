}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme='light']) {
    --paper: #0f1a1c; --surface: #152124; --ink: #e4eeeb; --muted: #93a6a6;
    --rule: #2a3c3f; --accent: #5dc7ad; --accent-ink: #0b1416; --danger: #f0877e; --warn: #e3b341;
    color-scheme: dark;
  }
}
:root[data-theme='dark'] {
  --paper: #0f1a1c; --surface: #152124; --ink: #e4eeeb; --muted: #93a6a6;
  --rule: #2a3c3f; --accent: #5dc7ad; --accent-ink: #0b1416; --danger: #f0877e; --warn: #e3b341;
  color-scheme: dark;
}

/* ---------- Basis ---------- */
* { box-sizing: border-box; }
body {
  margin: 0; background: var(--paper); color: var(--ink);
  font: 15px/1.55 var(--f-body);
  -webkit-font-smoothing: antialiased;
}
h1, h2, h3 { font-family: var(--f-display); font-weight: 650; margin: 0; letter-spacing: -0.01em; }
h1 { font-size: 2rem; line-height: 1.15; }
h2 { font-size: 1.2rem; margin-bottom: 12px; }
h3 { font-size: 1rem; margin: 22px 0 4px; }
p { margin: 6px 0 14px; max-width: 62ch; }
code { font-size: 0.85em; word-break: break-all; }
.muted { color: var(--muted); }
.small { font-size: 0.85rem; }
.right { text-align: right; }
.strong { font-weight: 700; }
.neg { color: var(--danger); }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }

/* ---------- Buttons & Eingaben ---------- */
.btn {
  padding: 9px 16px; border: 1px solid var(--rule); background: var(--surface); color: var(--ink);
  border-radius: 6px; font: inherit; font-weight: 600; cursor: pointer;
}
.btn:hover { border-color: var(--muted); }
.btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
.btn:disabled { opacity: 0.45; cursor: not-allowed; }
.link {
  background: none; border: 0; padding: 0; color: var(--accent); font: inherit;
  cursor: pointer; text-decoration: underline; text-underline-offset: 3px; text-align: left;
}
.link.danger { color: var(--danger); }
.icon-btn {
  display: inline-flex; align-items: center; justify-content: center; flex: none;
  width: 30px; height: 30px; padding: 0; border: 0; border-radius: 6px; background: none;
  color: var(--muted); font-size: 1.3rem; line-height: 1; cursor: pointer;
}
.icon-btn:hover { color: var(--danger); background: color-mix(in srgb, var(--danger) 12%, transparent); }
.push { margin-left: auto; }
.btn.danger { color: var(--danger); border-color: color-mix(in srgb, var(--danger) 45%, var(--rule)); }
.btn.danger:hover { background: color-mix(in srgb, var(--danger) 10%, transparent); border-color: var(--danger); }
input[aria-invalid='true'] { border-color: var(--danger); }

input, select {
  font: inherit; color: var(--ink); background: var(--surface);
  border: 1px solid var(--rule); border-radius: 6px; padding: 8px 10px; min-width: 0;
}
input::placeholder { color: var(--muted); opacity: 0.8; }
.cell-input { width: 100%; border-color: transparent; background: transparent; }
.cell-input:hover { border-color: var(--rule); }
.cell-input:focus { background: var(--surface); }
.title-input {
  font: 650 1.25rem/1.2 var(--f-display); border-color: transparent; background: transparent;
  padding: 4px 10px; width: min(340px, 100%);
}
.title-input:hover { border-color: var(--rule); }
.wide-input { width: min(360px, 100%); }
.num { text-align: right; font-variant-numeric: tabular-nums; }
.money { position: relative; display: block; }
.money input { padding-right: 24px; width: 100%; }
.money em { position: absolute; right: 9px; top: 50%; transform: translateY(-50%); font-style: normal; color: var(--muted); pointer-events: none; }
.row { display: flex; flex-wrap: wrap; gap: 10px; margin: 20px 0 8px; align-items: center; }
.dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 8px; flex: none; }
.dot.big { width: 16px; height: 16px; }

/* ---------- Rahmen ---------- */
.shell { display: grid; grid-template-columns: 232px 1fr; min-height: 100vh; }
.side {
  position: sticky; top: 0; height: 100vh; padding: 28px 20px; border-right: 1px solid var(--rule);
  display: flex; flex-direction: column; gap: 26px;
}
.brand { font: 700 1.5rem var(--f-display); letter-spacing: -0.02em; }
.who { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; font-size: 0.9rem; }
.who strong { overflow-wrap: anywhere; }
.nav { display: flex; flex-direction: column; gap: 2px; }
.nav button {
  text-align: left; padding: 8px 12px; border: 0; border-left: 3px solid transparent;
  background: none; color: var(--muted); font: inherit; cursor: pointer;
}
.nav button:hover { color: var(--ink); }
.nav button[aria-current='page'] { color: var(--ink); font-weight: 650; border-left-color: var(--accent); }
.main { padding: 40px 48px 90px; max-width: 1040px; width: 100%; }
.page-head { margin-bottom: 28px; }

/* ---------- Übersicht ---------- */
.total { margin-top: 4px; }
.total-num { font: 700 2.6rem var(--f-display); letter-spacing: -0.02em; }
.bar { display: flex; gap: 3px; height: 14px; margin: 14px 0 12px; border-radius: 3px; overflow: hidden; }
.bar span { transition: flex-grow 0.25s; min-width: 0; }
.legend { display: flex; flex-wrap: wrap; gap: 6px 32px; list-style: none; margin: 0 0 8px; padding: 0; }
.legend li { display: flex; align-items: center; gap: 4px; }
.empty { padding: 18px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
section + section { margin-top: 40px; }
.scroll { overflow-x: auto; }
.ledger { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
.ledger th, .ledger td { padding: 9px 12px; border-bottom: 1px solid var(--rule); text-align: left; vertical-align: baseline; }
.ledger thead th { font-weight: 600; color: var(--muted); border-bottom: 1.5px solid var(--ink); white-space: nowrap; }
.ledger .num { text-align: right; white-space: nowrap; }
.ledger .grp th { padding-top: 24px; font: 650 1rem var(--f-display); border-bottom: 0; color: var(--ink); }
.ledger .sub td { font-weight: 600; }
.ledger .grand td { font: 700 1.05rem var(--f-display); border-top: 2px solid var(--ink); border-bottom: 0; padding-top: 14px; }

/* ---------- Bearbeiten ---------- */
.block { padding-bottom: 8px; }
.block + .block { margin-top: 36px; }
.block-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding-bottom: 6px; border-bottom: 1.5px solid var(--ink); }
.block-head .muted { margin-left: auto; }
.erow, .drow {
  display: grid; align-items: center; gap: 8px; padding: 3px 0; border-bottom: 1px solid var(--rule);
  grid-template-columns: minmax(130px, 1.6fr) minmax(96px, 0.8fr) minmax(112px, 1fr) minmax(140px, 1.2fr) 30px;
}
.namecell { min-width: 0; }
.hint { display: block; padding: 0 10px 2px; font-size: 0.78rem; line-height: 1.3; color: var(--muted); }
select.special { border-color: color-mix(in srgb, var(--accent) 55%, var(--rule)); }
.sub-line { display: block; font-size: 0.8rem; line-height: 1.35; }
.drow { grid-template-columns: minmax(120px, 1fr) 120px 30px; max-width: 480px; }
.erow.acc {
  grid-template-columns: minmax(130px, 1.6fr) minmax(96px, 0.8fr) minmax(112px, 1fr) minmax(140px, 1.2fr) minmax(120px, 1fr) 30px;
}
.arow {
  display: grid; align-items: center; gap: 8px; padding: 3px 0; border-bottom: 1px solid var(--rule);
  grid-template-columns: minmax(120px, 1fr) auto 30px; max-width: 600px;
}
.badge {
  display: inline-block; margin-left: 8px; padding: 0 8px; border: 1px solid var(--rule); border-radius: 999px;
  font-size: 0.75rem; line-height: 1.6; color: var(--muted); white-space: nowrap; vertical-align: 1px;
}
.addrow { display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap; }
.addrow input:first-child { flex: 1 1 180px; }
.addrow input.num { width: 120px; }
.field-row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; padding: 14px 0 4px; }
.field-row > label { min-width: 120px; color: var(--muted); }
.field-row .money { width: 150px; }
.swatches { display: flex; gap: 8px; flex-wrap: wrap; }
.swatch { width: 22px; height: 22px; border-radius: 50%; border: 0; padding: 0; cursor: pointer; }
.swatch[aria-pressed='true'] { outline: 2px solid var(--ink); outline-offset: 2px; }

/* ---------- Start & Onboarding ---------- */
.start { max-width: 600px; margin: 0 auto; padding: 12vh 24px 60px; }
.start h1 { font-size: 2.4rem; }
.onboarding { max-width: 720px; }
.onboarding .person-row + .link { margin-top: 12px; }
.slots { list-style: none; margin: 22px 0; padding: 0; border-top: 1.5px solid var(--ink); }
.slots li { display: flex; align-items: center; gap: 8px; border-bottom: 1px solid var(--rule); }
.slot {
  flex: 1; display: flex; justify-content: space-between; gap: 16px; padding: 16px 4px;
  background: none; border: 0; font: inherit; color: inherit; cursor: pointer; text-align: left;
}
.slot-name { font: 650 1.1rem var(--f-display); }
