  .block-head .muted { margin-left: 0; }
  .save-state { margin: 0 0 0 auto; }
  .toast { left: 12px; right: 12px; bottom: 12px; max-width: none; }
}

/* ---------- Individuelle Verteilung & Vorlagen ---------- */
.warn { color: var(--warn); }
.erow.open { border-bottom: 0; }
.weights {
  display: flex; flex-wrap: wrap; align-items: center; gap: 8px 22px;
