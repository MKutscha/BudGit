.w-presets { display: flex; gap: 16px; }
.tpl { border-bottom: 1px solid var(--rule); }
.tpl .choice { border-bottom: 0; padding-bottom: 6px; }
.tpl details { margin: 0 0 14px 28px; font-size: 0.9rem; }
.tpl summary { cursor: pointer; color: var(--accent); }
.tpl ul { margin: 8px 0 0; padding-left: 18px; color: var(--muted); }

/* ---------- Schulden & Forderungen ---------- */
.debt-sum { display: flex; flex-wrap: wrap; gap: 6px 32px; list-style: none; margin: 0 0 28px; padding: 0; }
.debt {
  display: grid; align-items: center; gap: 8px; padding: 6px 4px 6px 10px; border-bottom: 1px solid var(--rule);
  border-left: 3px solid transparent;
  grid-template-columns: 112px minmax(110px, 1fr) minmax(140px, 1.4fr) 120px 170px auto;
}
.debt.overdue { border-left-color: var(--danger); background: color-mix(in srgb, var(--danger) 8%, transparent); }
.debt.overdue .due input { color: var(--danger); font-weight: 600; }
.debt .due { min-width: 0; }
.debt .due small { display: block; padding: 0 10px; font-size: 0.8rem; line-height: 1.3; color: var(--muted); }
.debt.overdue .due small { color: var(--danger); font-weight: 650; }
.debt.today .due small, .debt.soon .due small { color: var(--warn); }
.debt-actions { display: flex; align-items: center; justify-content: flex-end; gap: 6px; }
.btn.compact { padding: 4px 10px; font-size: 0.85rem; white-space: nowrap; }
.debt.done { grid-template-columns: 112px minmax(110px, 1.6fr) 110px minmax(130px, 1fr) auto; color: var(--muted); }
.debt.done b { color: var(--ink); }
.cell-text { min-width: 0; overflow-wrap: anywhere; }
.debt-add { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 14px; }
.debt-add > input:nth-of-type(1) { flex: 1 1 140px; }
.debt-add > input:nth-of-type(2) { flex: 2 1 180px; }
.debt-add input.num { width: 120px; }
