.progress { height: 3px; background: var(--rule); margin-bottom: 44px; }
.progress span { display: block; height: 100%; background: var(--accent); transition: width 0.25s; }
.big-input { width: 100%; font-size: 1.2rem; padding: 12px 14px; margin-top: 8px; }
.person-row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; padding: 10px 0; border-bottom: 1px solid var(--rule); }
.person-row > input { flex: 1 1 140px; }
.person-row .money { width: 190px; }
.choice { display: flex; gap: 12px; align-items: flex-start; padding: 14px 0; border-bottom: 1px solid var(--rule); cursor: pointer; }
.choice input { margin-top: 5px; accent-color: var(--accent); }

.toast {
  position: fixed; right: 24px; bottom: 24px; z-index: 10; min-width: 280px; max-width: min(440px, calc(100vw - 48px));
  display: flex; align-items: flex-start; gap: 8px; padding: 12px 8px 12px 16px;
  background: var(--surface); color: var(--ink); border: 1px solid var(--rule);
  border-left: 4px solid var(--accent); border-radius: 6px; box-shadow: 0 6px 24px rgba(0, 0, 0, 0.2);
}
.toast p { margin: 2px 0 0; flex: 1; }
.toast strong { display: block; margin-bottom: 2px; }
.toast.warning { border-left-color: var(--warn); }
