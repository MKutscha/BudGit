.pill {
  display: inline-block; margin-left: 8px; padding: 0 7px; border-radius: 999px;
  background: var(--danger); color: var(--accent-ink); font-size: 0.75rem; font-weight: 700; line-height: 1.5;
}
.alert {
  max-width: none; margin: 0 0 24px; padding: 10px 14px; border-radius: 6px;
  border: 1px solid color-mix(in srgb, var(--danger) 45%, var(--rule)); border-left: 4px solid var(--danger);
  background: color-mix(in srgb, var(--danger) 8%, transparent);
}

/* ---------- Verlauf (Rückgängig / Wiederholen) ---------- */
.history { display: flex; flex-direction: column; gap: 4px; }
.tool-btn {
  display: flex; align-items: center; gap: 8px; padding: 6px 12px; border: 0; border-radius: 6px;
  background: none; color: var(--muted); font: inherit; font-size: 0.9rem; cursor: pointer; text-align: left;
}
.tool-btn:hover:not(:disabled) { color: var(--ink); background: color-mix(in srgb, var(--ink) 7%, transparent); }
.tool-btn:disabled { opacity: 0.4; cursor: default; }
.backups { list-style: none; margin: 8px 0 0; padding: 0; max-width: 480px; border-top: 1.5px solid var(--ink); }
.backups li { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 8px 4px; border-bottom: 1px solid var(--rule); }

/* ---------- Druckansicht ---------- */
.page-head-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
.report-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px 24px; flex-wrap: wrap; margin-bottom: 10px; }
.check { display: inline-flex; align-items: center; gap: 8px; cursor: pointer; }
.check input { accent-color: var(--accent); }

/* Das Blatt ist immer hell, damit Vorschau und Ausdruck im dunklen Modus gleich aussehen. */
.paper {
  --surface: #ffffff; --ink: #15262b; --muted: #5a6c70; --rule: #cdd6d3; --accent: #0e5b4c; --danger: #a6322a;
  max-width: 210mm; margin: 18px auto 0; padding: 16mm 15mm; background: #ffffff; color: var(--ink);
  border-radius: 4px; box-shadow: 0 6px 28px rgba(0, 0, 0, 0.18);
}
.paper section + section { margin-top: 28px; }
.paper h1 { font-size: 1.7rem; margin-top: 2px; }
.paper h2 { font-size: 1.05rem; }
.paper .total-num { font-size: 2.1rem; }
.paper-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; padding-bottom: 14px; margin-bottom: 26px; border-bottom: 2px solid var(--ink); }
.paper-brand { font: 700 0.8rem var(--f-display); letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); }
.paper-sub { margin: 2px 0 0; font: 600 1.05rem var(--f-display); }
.paper-meta { display: grid; grid-template-columns: auto 1fr; gap: 2px 14px; margin: 0; font-size: 0.85rem; text-align: left; }
.paper-meta dt { color: var(--muted); }
.paper-meta dd { margin: 0; }
.paper-foot { margin-top: 36px; padding-top: 10px; border-top: 1px solid var(--rule); font-size: 0.75rem; color: var(--muted); }
.dot, .bar span, .swatch { -webkit-print-color-adjust: exact; print-color-adjust: exact; }

@page { size: A4; margin: 14mm 12mm; }
@media print {
  :root, :root[data-theme='dark'], :root:not([data-theme='x']) {
    --paper: #ffffff; --surface: #ffffff; --ink: #15262b; --muted: #5a6c70; --rule: #cdd6d3;
    --accent: #0e5b4c; --danger: #a6322a; --warn: #9a6700; color-scheme: light;
  }
  body { background: #ffffff; font-size: 12px; }
  .side, .toast, .no-print { display: none !important; }
  .shell { display: block; }
  .main { padding: 0; max-width: none; }
  .scroll { overflow: visible; }
  .paper { margin: 0; padding: 0; max-width: none; border-radius: 0; box-shadow: none; }
  .ledger thead { display: table-header-group; }
  .ledger tr { break-inside: avoid; }
  .ledger .grp { break-after: avoid; }
  h1, h2, h3 { break-after: avoid; }
  .bar span { transition: none; }
}

/* ---------- Handy-Schicht (Web-Build; am Desktop greifen die Regeln kaum) ---------- */
html { -webkit-text-size-adjust: 100%; touch-action: manipulation; }
body { overscroll-behavior-y: contain; -webkit-tap-highlight-color: transparent; }
.shell { min-height: 100dvh; }
.total-num { font-size: clamp(1.9rem, 9vw, 2.6rem); }
h1 { font-size: clamp(1.5rem, 7vw, 2rem); }

@media (pointer: coarse) {
  input, select, textarea { font-size: 16px; min-height: 44px; } /* verhindert den Auto-Zoom von iOS */
  .btn, .tool-btn { min-height: 44px; }
  .icon-btn { min-width: 44px; min-height: 44px; }
  .swatch { width: 32px; height: 32px; }
}
@media (hover: none) { .btn:hover, .nav button:hover { border-color: var(--rule); color: inherit; } }

@media (min-width: 861px) { .side { height: 100dvh; } }

@media (max-width: 640px) {
  .side { height: auto; padding: calc(env(safe-area-inset-top) + 10px) 16px 10px; gap: 4px 12px; }
  .nav {
    position: fixed; inset: auto 0 0 0; z-index: 20; width: auto;
    display: grid; grid-template-columns: repeat(5, 1fr); gap: 0;
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--surface); border-top: 1px solid var(--rule);
  }
  .nav button {
    min-height: 56px; border: 0; border-top: 3px solid transparent; padding: 6px 2px;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; font-size: 0.72rem;
  }
  .nav button[aria-current='page'] { border-top-color: var(--accent); color: var(--ink); }
  .main { padding: 20px max(16px, env(safe-area-inset-left)) calc(88px + env(safe-area-inset-bottom)); }
  .toast { bottom: calc(72px + env(safe-area-inset-bottom)); }
  .history, .save-state { display: none; }
  /* Posten als Karten statt Tabellenzeile */
  .erow, .erow.acc {
    display: grid; grid-template-columns: 1fr 1fr; gap: 8px; padding: 12px; margin: 10px 0;
    border: 1px solid var(--rule); border-radius: 12px; background: var(--surface);
  }
  .erow > :first-child { grid-column: 1 / -1; }
  .erow > .icon-btn { grid-column: 1 / -1; justify-self: end; }
}
/* Tastatur offen → Tab-Leiste weg, damit sie nicht über den Feldern schwebt */
@media (max-width: 640px) { .shell:has(input:focus, select:focus) .nav { display: none; } }

/* ---------- Bestätigen als Bottom-Sheet ---------- */
dialog.sheet {
  margin: auto auto 0; width: min(520px, 100%); max-width: 100%; border: 0; border-radius: 16px 16px 0 0;
  padding: 20px 20px calc(20px + env(safe-area-inset-bottom)); background: var(--surface); color: var(--ink);
}
dialog.sheet::backdrop { background: rgb(0 0 0 / 0.45); }
.sheet-actions { display: flex; gap: 10px; justify-content: flex-end; }

/* ---------- Hinweise der Web-Version ---------- */
.web-note {
  display: flex; gap: 12px; align-items: flex-start; justify-content: space-between;
  margin: 0 0 16px; padding: 12px 14px; border: 1px solid var(--rule); border-left: 4px solid var(--warn);
  border-radius: 8px; background: var(--surface); font-size: 0.9rem;
}
.web-note p { margin: 0; }

.web-note p { margin: 0; flex: 1; min-width: 0; }
.web-notes.standalone {
  max-width: 600px; margin: 0 auto;
  padding: calc(env(safe-area-inset-top) + 16px) 24px 0;
}

.web-note .btn { flex: none; }

.main { min-width: 0; }
@media (min-width: 861px) { .shell { grid-template-columns: 232px minmax(0, 1fr); } }
@media (min-width: 861px) and (max-width: 1100px) { .shell { grid-template-columns: 200px minmax(0, 1fr); } }
 
/* Tabellen auf dem Handy (nur dort, wo die Komponente `compact` bekommt, nicht in der Druckansicht) */
@media (max-width: 640px) {
  .ledger.compact th, .ledger.compact td { padding: 8px 8px; font-size: 0.9rem; }
  .ledger.compact th:first-child, .ledger.compact td:first-child {
    position: sticky; left: 0; z-index: 1; background: var(--paper); max-width: 9.5rem;
  }
 
  /* „Was übrig bleibt“: pro Person eine Karte */
  .ledger.stack, .ledger.stack tbody, .ledger.stack tr, .ledger.stack td { display: block; }
  .ledger.stack thead { display: none; }
  .ledger.stack tr {
    margin: 10px 0; padding: 10px 12px;
    border: 1px solid var(--rule); border-radius: 12px; background: var(--surface);
  }
  .ledger.stack td { display: flex; justify-content: space-between; gap: 12px; padding: 3px 0; border: 0; }
  .ledger.stack td::before { content: attr(data-label); color: var(--muted); }
  .ledger.stack td:first-child {
    justify-content: flex-start; margin-bottom: 4px; padding-bottom: 6px;
    border-bottom: 1px solid var(--rule); font: 650 1rem var(--f-display);
  }
  .ledger.stack td:first-child::before { content: none; }
  .ledger.stack td:last-child { margin-top: 4px; padding-top: 6px; border-top: 1px solid var(--rule); }
}
 
@media (max-width: 640px) {
  /* Größere Tippflächen und sichtbare Feldränder (auf dem Handy gibt es kein Hover) */
  .icon-btn { width: 44px; height: 44px; }
  .cell-input { border-color: var(--rule); background: var(--surface); }
  .swatch { width: 32px; height: 32px; }
 
  /* Gruppen- und Personenkopf: Name, Summe und Papierkorb in einer Zeile */
  .block-head { flex-wrap: nowrap; gap: 6px; }
  .title-input { flex: 1 1 0; width: auto; min-width: 0; }
  .block-head .muted { margin-left: auto; white-space: nowrap; font-size: 0.85rem; }
  .block-head .icon-btn { margin-right: -12px; }
 
  /* Kosten: ein Posten = eine Karte (Zeile und individuelle Anteile zusammen) */
  .expense {
    margin: 10px 0; padding: 12px;
    border: 1px solid var(--rule); border-radius: 12px; background: var(--surface);
  }
  .erow, .erow.acc {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 8px;
    margin: 0; padding: 0; border: 0;
  }
  .erow > .namecell { grid-column: 1 / -1; grid-row: 1; padding-right: 40px; }
  .erow > .icon-btn { grid-column: 2; grid-row: 1; justify-self: end; align-self: start; margin: -8px -8px 0 0; }
  /* ohne Konto steht die Aufteilung allein in der Zeile, dann über die volle Breite */
  .erow:not(.acc) > select:nth-of-type(2) { grid-column: 1 / -1; }
  .weights { margin-top: 10px; padding: 12px 0 0; border: 0; border-top: 1px solid var(--rule); }
 
  /* Konten und eigene Abzüge */
  .drow, .arow { max-width: none; }
  .drow { grid-template-columns: minmax(0, 1fr) 120px 44px; }
  .arow { grid-template-columns: minmax(0, 1fr) 44px; }
 
  /* Personen: Netto-Feld und Farben */
  .field-row > label { flex: 1 1 100%; min-width: 0; }
  .field-row .money { flex: 1 1 140px; width: auto; }
  .swatches { flex: 1 1 100%; }
 
  /* „Neuer Posten“ / „Neuer Abzug“: Name volle Breite, darunter Betrag und Button */
  .addrow > input:first-child { flex: 1 1 100%; }
  .addrow input.num { flex: 1 1 130px; width: auto; }
  .addrow .btn { flex: 1 1 130px; }
 
  /* Schulden: offene Einträge als Karte. Reihenfolge: Art | Betrag, Name, Zweck, Frist | Aktionen */
  .debt:not(.done) {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 8px;
    margin: 10px 0; padding: 12px;
    border: 1px solid var(--rule); border-left-width: 4px; border-radius: 12px; background: var(--surface);
  }
  .debt.overdue { border-left-color: var(--danger); background: color-mix(in srgb, var(--danger) 8%, var(--surface)); }
  .debt:not(.done) > select { order: 1; }
  .debt:not(.done) > .money { order: 2; }
  .debt:not(.done) > :nth-child(2) { order: 3; grid-column: 1 / -1; }
  .debt:not(.done) > :nth-child(3) { order: 4; grid-column: 1 / -1; }
  .debt:not(.done) > .due { order: 5; }
  .debt:not(.done) > .debt-actions { order: 6; }
 
  /* Schulden: Formular untereinander, Beschriftung über dem Datum */
  .debt-add { display: grid; grid-template-columns: 1fr; gap: 10px; }
  .debt-add input.num { width: 100%; }
  .due-label { display: grid; gap: 4px; }
  .debt-add .btn { width: 100%; }
}
